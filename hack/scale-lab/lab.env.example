# KWOK scale-lab configuration. Copy to lab.env and edit for your machines.
#   cp lab.env.example lab.env && $EDITOR lab.env
# setup.sh sources this file. All hosts must be reachable by passwordless SSH
# as root (ssh-copy-id first).

# --- Machines (roles may share a host, but the KubeBrain LEADER must NOT sit on
#     the TiKV host: its collector crawls and every write hits the 3s backstop). ---
STORE_HOST=10.224.0.13        # PD + TiKV (+ optional TiDB for GC safepoint)
BRAIN_HOST=10.224.0.14        # KubeBrain leader
CTRL_HOST=10.224.0.12         # orchestration: tiup control, Grafana/Prometheus, KWOK, loadgen
# Extra KubeBrain replicas for failover tests (space-separated, optional):
BRAIN_REPLICAS="10.224.0.13"  # a follower on the store host is fine (never leads under load)

# --- KubeBrain ---
KB_BIN=/usr/local/bin/kube-brain
KB_CLIENT_PORT=3379
KB_PEER_PORT=3380
KB_INFO_PORT=8080
KB_WATCH_CACHE=2000000        # in-memory ring; event log + scan back it beyond this
KB_COUNT_INDEX_MAX=60000000

# --- Storage (tiup) ---
TIUP_CLUSTER=kwok-lab
TIKV_MAX_REPLICAS=1           # lab default; 3 = real quorum (see #53)

# --- KWOK ---
KWOK_SHARDS=6                 # kwok@0..N-1 template units; spread across hosts as needed
KWOK_NODE_LEASE_SECONDS=4000

# --- Control plane: "k3s" (fast) or "bare" (standard apiserver+kcm+scheduler) ---
CONTROLPLANE=k3s
KUBECONFIG_OUT=$HOME/.kube-lab/config
